# ==============================================================================
# DJELI'S MESSAGING API - VARIABLES D'ENVIRONNEMENT
# ==============================================================================

# Domaine de l'application
NEXT_PUBLIC_APP_URL=https://messaging.djelis.com
NODE_ENV=development

# ------------------------------------------------------------------------------
# SUPABASE (Base de Données PostgreSQL & Authentification)
# ------------------------------------------------------------------------------
# URL de votre projet Supabase (ex: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé anonyme publique pour le frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Clé de rôle de service (Service Role Key) - STRICTEMENT CONFIDENTIEL / BACKEND UNIQUEMENT
# Permet au serveur de contourner le RLS pour l'authentification des clés API et l'orchestration des SMS
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete

# ------------------------------------------------------------------------------
# FOURNISSEUR SMS 1 : INFOBIP (Connecteur de production réel)
# ------------------------------------------------------------------------------
# URL de base dédiée fournie sur votre compte Infobip (ex: https://xxxx.api.infobip.com)
INFOBIP_BASE_URL=https://votre-sous-domaine.api.infobip.com

# Clé API générée depuis le portail Infobip (Developers > API Keys)
INFOBIP_API_KEY=votre-cle-api-infobip

# Sender ID par défaut (ex: DJELIS, max 11 caractères alphanumériques)
INFOBIP_DEFAULT_SENDER=DJELIS

# URL de callback pour les rapports de livraison (DLR Webhook)
INFOBIP_NOTIFY_URL=https://messaging.djelis.com/api/v1/webhooks/infobip

# Secret optionnel pour la vérification de signature du webhook Infobip
INFOBIP_WEBHOOK_SECRET=votre-secret-webhook-infobip

# ------------------------------------------------------------------------------
# FOURNISSEUR SMS 2 : ORANGE MALI (Squelette inactif en attente)
# ------------------------------------------------------------------------------
# ORANGE_MALI_BASE_URL=https://api.orange.com
# ORANGE_MALI_CLIENT_ID=
# ORANGE_MALI_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# FILE D'ATTENTE SERVERLESS (Upstash QStash - Production Vercel)
# ------------------------------------------------------------------------------
# Token QStash pour déléguer les envois et répétitions sans bloquer les lambdas Vercel
QSTASH_TOKEN=votre-token-qstash
INTERNAL_WORKER_SECRET=votre-secret-interne-worker-securise

# ------------------------------------------------------------------------------
# SUPERVISION SENTRY (Optionnel)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxx
